# ─────────────────────────────────────────────────────────────
# Shopify Storefront API (headless) — valeurs PUBLIQUES
# Copier ce fichier en `.env.local` et remplir les deux valeurs.
# ⚠️ NE JAMAIS mettre ici la clé Admin secrète (Admin API access token).
#    Seul le jeton STOREFRONT (public) est utilisé.
# ─────────────────────────────────────────────────────────────

# Domaine technique de la boutique (pas le domaine public du site)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=votreboutique.myshopify.com

# Jeton d'accès Storefront API (public) — voir GUIDE-SHOPIFY.md
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# Variables des Cloudflare Pages Functions (formulaires)
#
# ⚠️ Leur place réelle est Cloudflare Pages → Settings → Environment
#    variables, PAS ce fichier : le site est en static export, ces valeurs
#    ne sont lues que par functions/lead.js, côté serveur.
#    On ne les met ici QUE pour lancer `npx tsx scripts/check-outils.mts`
#    depuis le poste. La clé Klaviyo est PRIVÉE : jamais dans le front.
# ─────────────────────────────────────────────────────────────

# Resend — sans cette clé, le formulaire de compte pro ne capte aucun lead
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Destinataires de la notification, séparés par des virgules
LEAD_TO_EMAIL=contact@exemple.fr
# Expéditeur — son domaine doit être VÉRIFIÉ dans Resend, sinon tout envoi échoue
LEAD_FROM_EMAIL=MANIKA.LAB <contact@exemple.fr>

# Klaviyo — clé PRIVÉE.
# Scopes requis (vérifiés dans la doc API le 14/09/2026) :
#   profiles:read, profiles:write, lists:read, lists:write,
#   events:write, subscriptions:write
# ⚠️ Le job d'abonnement exige lists:WRITE (pas read) EN PLUS de
#    subscriptions:write — l'un ou l'autre manquant donne un 403 à l'abonnement
#    alors que tout le reste continue de fonctionner.
# ⚠️ Les scopes ne sont pas modifiables après création : une clé incomplète
#    doit être supprimée et recréée.
# Vérifier la chaîne : npx tsx scripts/test-klaviyo.mts votre@email.com
# KLAVIYO_LIST_ID n'est nécessaire QUE pour l'abonnement à la liste ; sans lui,
# les profils et les évènements partent quand même.
KLAVIYO_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx
KLAVIYO_LIST_ID=XXXXXX

# ─────────────────────────────────────────────────────────────
# Diagnostic uniquement (scripts/check-outils.mts)
# ─────────────────────────────────────────────────────────────

# Domaine public une fois acheté — sert aux contrôles SPF / DKIM / DMARC
SITE_DOMAIN=
# URL du site déployé — sert au ping du formulaire
SITE_URL=
